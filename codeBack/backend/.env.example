# Copier ce fichier vers .env seulement si .env n'existe pas encore.
# .env est privé : ne jamais publier l'URI complète ni la clé Cosmos DB.
# Copier l'URI MongoDB fournie par Azure Cosmos DB, avec la base capsavoir.
# Conserver les paramètres fournis : ssl, replicaSet, retrywrites=false,
# maxIdleTimeMS et appName, s'il est présent.
# Exemple de format uniquement, avec des valeurs fictives :
# mongodb://UTILISATEUR:MOT_DE_PASSE@SERVEUR.mongo.cosmos.azure.com:10255/capsavoir?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000
MONGODB_URI=
# _id du formateur dans cette même base, sans ObjectId(...) autour.
# Dans Utilisateur, le profil de démonstration a l'email formateur.test@capsavoir.test.
# Contexte temporaire sans connexion utilisateur pour les US08/09/10.
FORMATEUR_ID=
PORT=3000
# Facultatif : vide = dossier uploads du backend. Prévoir un dossier persistant sur Azure.
UPLOAD_DIR=
# US02 : clé de signature des jetons de session. Longue chaîne aléatoire, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# En local, chacun choisit la sienne. En production : uniquement dans Azure (variables d'environnement).
JWT_SECRET=
# Facultatif : durée de validité d'une session (défaut 2h). Exemples : 30m, 2h, 1d.
JWT_DUREE=
