# Copy to .env for local development. Never commit .env.
# URI de la vraie base choisie dans Compass (Atlas, Azure Cosmos DB, etc.).
# Laisser vide tant que la connexion n'est pas choisie. Aucun serveur local créé.
# Cosmos : conserver retrywrites=false dans la chaîne fournie.
MONGODB_URI=
# _id d'un Utilisateur existant ayant le rôle FORMATEUR.
# Contexte temporaire sans connexion utilisateur pour les US08/09/10.
FORMATEUR_ID=
PORT=3000
# Variable déjà présente dans le socle, conservée pour l'équipe US02.
# Non utilisée par l'espace formateur : aucun JWT n'est implémenté ici.
JWT_SECRET=change-me
